{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*node_modules/*": "deny",
      "*public/splats/*": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*node_modules/*": "deny",
      "*public/splats/*": "deny",
      "*.check/*": "deny"
    },
    "bash": {
      "*": "ask",
      "npm test": "allow",
      "npm run check*": "allow",
      "node *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls*": "allow"
    }
  }
}
